local function IsRealCandy(part)
    if not part or not part.Parent or not part:IsDescendantOf(workspace) then return false end
    if part:IsA("BasePart") and (part.Transparency >= 1 or not part.CanTouch) then return false end
    return true
end

local function TeleportToCandy(target)
    local root = get_root()
    if not root or not IsRealCandy(target) or Bypass.paused() then return end
    local distance = (root.Position - target.Position).Magnitude
    if distance < 0.5 then
        pcall(function() firetouchinterest(root, target, 0) end)
        task.wait(0.02)
        pcall(function() firetouchinterest(root, target, 1) end)
        return
    end
    local speed = math.max(1, cfg.tween_speed)
    local time = distance / speed
    local jitter = Vector3.new(
        (math.random() - 0.5) * cfg.tp_jitter, 0,
        (math.random() - 0.5) * cfg.tp_jitter)
    local dest = CFrame.new(target.Position + jitter)
    local tween = TweenService:Create(root, TweenInfo.new(time, cfg.tween_easing), { CFrame = dest })
    tween:Play()
    local start_time = tick()
    while AutoCandyRunning and not Bypass.paused() do
        if not IsRealCandy(target) then break end
        if (root.Position - target.Position).Magnitude <= 0.3 then break end
        if tick() - start_time > time + 2 then break end
        task.wait()
    end
    pcall(function() tween:Cancel() end)
    if IsRealCandy(target) then
        pcall(function() firetouchinterest(root, target, 0) end)
        task.wait(0.02)
        pcall(function() firetouchinterest(root, target, 1) end)
    end
    if cfg.stealth_spoof then pcall(function() Bypass.spoof_state(get_hum()) end) end
end

local function GetClosestCandies()
    local root = get_root(); if not root then return {} end
    local list = {}
    local container = workspace:FindFirstChild("Normal") or workspace
    for _, obj in ipairs(container:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("candy") or n:find("coin") then
            local part
            if obj:IsA("BasePart") then part = obj
            elseif obj:IsA("Model") then part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") end
            if IsRealCandy(part) then
                table.insert(list, { Part = part, Distance = (root.Position - part.Position).Magnitude })
            end
        end
    end
    table.sort(list, function(a, b) return a.Distance < b.Distance end)
    return list
end

local function CheckBagFull()
    local full = false
    pcall(function()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        if ls then
            local stat = ls:FindFirstChild("Candies") or ls:FindFirstChild("Doces") or ls:FindFirstChild("Coins")
            if stat and stat.Value >= cfg.bag_full then full = true end
        end
    end)
    return full
end

task.spawn(function()
    while not Bypass.is_killed() do
        if AutoCandyRunning and not Bypass.paused() then
            local full = CheckBagFull()
            local candies = GetClosestCandies()
            if full or #candies == 0 then
                if not triggeredFling then triggeredFling = true; TriggerAutoFling() end
            else
                triggeredFling = false
                local c = candies[1]
                if c and IsRealCandy(c.Part) then TeleportToCandy(c.Part) end
            end
            task.wait(cfg.scan_wait)
        else
            triggeredFling = false
            task.wait(cfg.idle_wait)
        end
    end
end)


if HAS_HOOKMETA then
    local old_index
    old_index = hookmetamethod(game, "__index", function(self, key)
        if self == mouse and key == "Hit" and aim_override_pos and tick() < aim_override_until then
            return CFrame.new(aim_override_pos)
        end
        return old_index(self, key)
    end)
    local old_namecall
    old_namecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if self == workspace and aim_override_pos and tick() < aim_override_until then
            if method == "Raycast" then
                local args = {...}
                local origin = args[1]
                if typeof(origin) == "Vector3" then
                    args[2] = (aim_override_pos - origin).Unit * 2000
                    return old_namecall(self, table.unpack(args))
                elseif typeof(origin) == "Ray" then
                    args[1] = Ray.new(origin.Origin, (aim_override_pos - origin.Origin).Unit * 2000)
                    return old_namecall(self, table.unpack(args))
                end
            elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList"
            or method == "FindPartOnRayWithWhitelist" then
                local args = {...}
                local r = args[1]
                if typeof(r) == "Ray" then
                    args[1] = Ray.new(r.Origin, (aim_override_pos - r.Origin).Unit * 2000)
                    return old_namecall(self, table.unpack(args))
                end
            end
        end
        return old_namecall(self, ...)
    end)
end

local function arm_silent_override()
    local myRole = GetPlayerRole(LocalPlayer)
    local myRoot = get_root()
    if not myRoot then return end
    local target_part
    if myRole == "Sheriff" and cfg.silent_sheriff then
        local m = GetMurdererPlayer()
        if m and m.Character then
            local hum = m.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                target_part = m.Character:FindFirstChild(cfg.silent_aim_head and "Head" or "HumanoidRootPart")
            end
        end
    elseif myRole == "Murderer" and cfg.silent_murderer then
        local best, bestD = nil, cfg.silent_hitbox
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local rp = p.Character:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and rp then
                    local d = (rp.Position - myRoot.Position).Magnitude
                    if d < bestD then bestD = d; best = p.Character:FindFirstChild(cfg.silent_aim_head and "Head" or "HumanoidRootPart") end
                end
            end
        end
        target_part = best
    end
    if not target_part then return end
    aim_override_pos = target_part.Position
    aim_override_until = tick() + 0.15
end

local knife_busy = false
local function silent_knife_kill()
    if knife_busy or not cfg.silent_knife_teleport then return end
    if GetPlayerRole(LocalPlayer) ~= "Murderer" then return end
    local char = LocalPlayer.Character; if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool or tool.Name:lower() ~= "knife" then return end
    local myRoot = get_root(); if not myRoot then return end
    local best, bestD = nil, cfg.silent_knife_range
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local rp = p.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and rp then
                local d = (rp.Position - myRoot.Position).Magnitude
                if d < bestD then bestD = d; best = { root = rp, char = p.Character } end
            end
        end
    end
    if not best then return end
    knife_busy = true
    local original_cf = myRoot.CFrame
    task.spawn(function()
        pcall(function()
            myRoot.CFrame = best.root.CFrame * CFrame.new(0, 0, 1)
            task.wait(0.06)
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    for _, tp in ipairs(best.char:GetDescendants()) do
                        if tp:IsA("BasePart") then
                            pcall(function() firetouchinterest(part, tp, 0) end)
                            pcall(function() firetouchinterest(part, tp, 1) end)
                        end
                    end
                end
            end
            task.wait(0.04)
            myRoot.CFrame = original_cf
        end)
        task.wait(0.12)
        knife_busy = false
    end)
end


-- =====================================================================
-- BYPASS
-- =====================================================================
local Bypass = {}
do
    local session_start  = tick()
    local WARMUP_SECONDS = 20
    local warmup_done    = false
    local tokens, MAX_TOKENS, REFILL_RATE = 12, 12, 10
    local last_refill    = tick()
    local flag_strikes, last_strike_time, backoff_until = 0, 0, 0
    local last_pos_sample, last_pos_time = nil, tick()
    local snapbacks = 0
    local kill_events, kill_window_start, KILLED = 0, tick(), false

    local function refill()
        local now = tick()
        tokens = math.min(MAX_TOKENS, tokens + (now - last_refill) * REFILL_RATE)
        last_refill = now
    end
    function Bypass.consume(n)
        refill(); n = n or 1
        if tokens < n then task.wait((n - tokens) / REFILL_RATE + math.random() * 0.03); refill() end
        tokens = tokens - n
    end
    function Bypass.is_killed() return KILLED end
    function Bypass.is_warmup()
        if warmup_done then return false end
        if tick() - session_start >= WARMUP_SECONDS then warmup_done = true; return false end
        return true
    end
    function Bypass.warmup_factor()
        if not Bypass.is_warmup() then return 1.0 end
        local p = (tick() - session_start) / WARMUP_SECONDS
        return 0.5 + 0.5 * math.clamp(p, 0, 1)
    end
    function Bypass.paused() return KILLED or tick() < backoff_until end
    function Bypass.pause(s, reason)
        backoff_until = math.max(backoff_until, tick() + s)
        if reason then warn("[bypass] backoff " .. string.format("%.1f", s) .. "s — " .. reason) end
    end
    function Bypass.register_strike(reason)
        flag_strikes = flag_strikes + 1
        last_strike_time = tick()
        Bypass.pause(math.min(8, 1 + flag_strikes * 1.2), reason or ("strike " .. flag_strikes))
        if flag_strikes >= 5 then
            local now = tick()
            if now - kill_window_start > 60 then kill_events, kill_window_start = 0, now end
            kill_events = kill_events + 1
            if kill_events >= 4 then KILLED = true; warn("[bypass] KILL SWITCH ativo") end
        end
    end
    function Bypass.decay()
        if tick() - last_strike_time > 30 and flag_strikes > 0 then
            flag_strikes = flag_strikes - 1; last_strike_time = tick()
        end
    end
    function Bypass.watchdog(root, on_flag)
        if not root then return end
        local now = tick()
        if now - last_pos_time < 0.4 and last_pos_sample then
            local d = (root.Position - last_pos_sample).Magnitude
            if d > 0.1 and d < 1.0 then
                snapbacks = snapbacks + 1
                if snapbacks >= 3 then if on_flag then on_flag("snapback") end; snapbacks = 0 end
            else snapbacks = 0 end
        end
        last_pos_sample, last_pos_time = root.Position, now
    end
    function Bypass.stealth_move(root, target_pos, opts)
        if not root or Bypass.paused() then return false end
        opts = opts or {}
        local factor = Bypass.warmup_factor()
        local max_step = math.max(4, math.floor((opts.step or 16) * factor))
        local pace = opts.pace or 0.035
        local start = root.Position
        if (target_pos - start).Magnitude < 0.5 then return true end
        local steps = math.min(math.ceil((target_pos - start).Magnitude / max_step), 25)
        for i = 1, steps do
            if Bypass.paused() then return false end
            Bypass.consume(0.4)
            root.CFrame = CFrame.new(start:Lerp(target_pos, i / steps))
            task.wait((pace + math.random() * pace * 0.6) * (2 - factor))
        end
        return true
    end
    function Bypass.spoof_state(hum)
        if not hum then return end
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            local c = hum:GetState()
            if c == Enum.HumanoidStateType.Physics
            or c == Enum.HumanoidStateType.PlatformStanding
            or c == Enum.HumanoidStateType.Ragdoll then
                hum:ChangeState(hum:GetState() == Enum.HumanoidStateType.Freefall
                    and Enum.HumanoidStateType.Freefall or Enum.HumanoidStateType.Running)
            end
        end)
    end
    function Bypass.stats()
        return { strikes = flag_strikes, killed = KILLED, warmup = Bypass.is_warmup(), tokens = tokens }
    end
end


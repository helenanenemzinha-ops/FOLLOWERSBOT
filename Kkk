local function GetMurdererPlayer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local c = p.Character
            if (p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild("Knife"))
            or (c and c:FindFirstChild("Knife")) then return p end
        end
    end
end
local function GetSheriffPlayer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local c = p.Character
            if (p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild("Gun"))
            or (c and c:FindFirstChild("Gun")) then return p end
        end
    end
end
local function GetPlayerRole(p)
    local c = p.Character
    if not c then return "Innocent" end
    if p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild("Knife") then return "Murderer" end
    if c:FindFirstChild("Knife") then return "Murderer" end
    if p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild("Gun") then return "Sheriff" end
    if c:FindFirstChild("Gun") then return "Sheriff" end
    return "Innocent"
end


local function claim_owner(root)
    pcall(function() if sethiddenproperty then sethiddenproperty(root, "NetworkOwnership", LocalPlayer) end end)
    pcall(function() if syn and syn.set_network_owner then syn.set_network_owner(root, LocalPlayer) end end)
    pcall(function() if setnetworkowner then setnetworkowner(root, LocalPlayer) end end)
end

local function launch(targetRoot, myRoot)
    if not targetRoot or not myRoot or Bypass.paused() then return end
    claim_owner(targetRoot)
    local dir = (targetRoot.Position - myRoot.Position)
    if dir.Magnitude < 0.1 then dir = myRoot.CFrame.LookVector end
    dir = dir.Unit
    local impulse = (dir * cfg.launch_out) + Vector3.new(0, cfg.launch_up, 0)
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = impulse; bv.P = 8000; bv.Parent = targetRoot
    local tHum = targetRoot.Parent and targetRoot.Parent:FindFirstChildOfClass("Humanoid")
    if tHum then
        pcall(function()
            tHum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
            tHum:ChangeState(Enum.HumanoidStateType.Physics)
        end)
        task.delay(0.12, function() pcall(function() tHum:ChangeState(Enum.HumanoidStateType.Running) end) end)
    end
    spawn_emoji(targetRoot)
    task.delay(0.5, function() if bv and bv.Parent then bv:Destroy() end end)
end

local function scan_window()
    if not dropkick_window or Bypass.paused() then return end
    local myRoot = get_root(); if not myRoot then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and not dropkick_hit[p.Character] then
            local rp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if rp and hum and hum.Health > 0 and (rp.Position - myRoot.Position).Magnitude <= cfg.launch_hitbox then
                dropkick_hit[p.Character] = true
                launch(rp, myRoot)
            end
        end
    end
end
RunService.Heartbeat:Connect(scan_window)

local function dropkick()
    if not cfg.dropkick_enabled or Bypass.paused() then return end
    local now = tick()
    if now - dropkick_last < cfg.dropkick_cd then return end
    dropkick_last = now
    local myRoot, myHum = get_root(), get_hum()
    if not myRoot or not myHum then return end
    Bypass.consume(1); pcall(function() Bypass.spoof_state(myHum) end)
    local anim = myHum:FindFirstChild("dropkick") or myHum:LoadAnimation(dropkick_anim)
    anim:Play(0.05, 1, 1.5); anim.Name = "dropkick"
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = myRoot.CFrame.LookVector * math.min(cfg.dropkick_boost, 110)
    bv.P = 6000; bv.Parent = myRoot
    task.delay(0.22, function() if bv and bv.Parent then bv:Destroy() end end)
    dropkick_window = true; dropkick_hit = {}
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                local conn
                conn = part.Touched:Connect(function(hit)
                    if not dropkick_window or Bypass.paused() then return end
                    local hc = hit:FindFirstAncestorOfClass("Model")
                    if not hc or hc == LocalPlayer.Character then return end
                    if Players:GetPlayerFromCharacter(hc) == nil or dropkick_hit[hc] then return end
                    local rp = hc:FindFirstChild("HumanoidRootPart")
                    local hum = hc:FindFirstChildOfClass("Humanoid")
                    if rp and hum and hum.Health > 0 then
                        dropkick_hit[hc] = true
                        launch(rp, myRoot)
                    end
                end)
                task.delay(cfg.window_duration + 0.1, function() conn:Disconnect() end)
            end
        end
    end
    task.delay(cfg.window_duration, function() dropkick_window = false; dropkick_hit = {} end)
end


local function TriggerAutoFling()
    if isFlinging or not AutoFlingAfterEnabled or Bypass.is_killed() then return end
    isFlinging = true
    task.spawn(function()
        local start = tick()
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if tick() - start >= cfg.autofling_dur or Bypass.is_killed() then
                if conn then conn:Disconnect() end; isFlinging = false; return
            end
            if Bypass.paused() then return end
            local murder = GetMurdererPlayer()
            if murder and murder.Character then
                local tr = murder.Character:FindFirstChild("HumanoidRootPart")
                local mr = get_root()
                if tr and mr then
                    pcall(function() Bypass.stealth_move(mr, tr.Position, { step = 14, pace = 0.03 }) end)
                    local bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bv.Velocity = cfg.fling_lin_vel; bv.P = 5000; bv.Parent = mr
                    task.delay(0.3, function() if bv and bv.Parent then bv:Destroy() end end)
                end
            end
        end)
    end)
end


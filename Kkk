local RGB = { targets = {}, hue = 0, speed = 0.15 }
RunService.RenderStepped:Connect(function(dt)
    RGB.hue = (RGB.hue + dt * RGB.speed) % 1
    local c1 = Color3.fromHSV(RGB.hue, 0.85, 1)
    local c2 = Color3.fromHSV((RGB.hue + 0.33) % 1, 0.85, 1)
    local c3 = Color3.fromHSV((RGB.hue + 0.66) % 1, 0.85, 1)
    for _, t in ipairs(RGB.targets) do
        if t.gradient and t.gradient.Parent then
            pcall(function()
                t.gradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, c1),
                    ColorSequenceKeypoint.new(0.5, c2),
                    ColorSequenceKeypoint.new(1, c3),
                })
            end)
        end
        if t.stroke and t.stroke.Parent then
            pcall(function() t.stroke.Color = c1 end)
        end
    end
end)

-- CORRIGIDO: drag detection sem input.Changed bloqueando InputEnded
local function makeDraggable(container, handle, onClick)
    handle = handle or container
    local dragging = false
    local moved = false
    local dragStart, startPos
    local THRESHOLD = 6

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = container.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > THRESHOLD or math.abs(delta.Y) > THRESHOLD then
                moved = true
            end
            if moved then
                container.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            local wasMoved = moved
            dragging = false
            moved = false
            if not wasMoved and onClick then
                task.spawn(onClick)
            end
        end
    end)
end

local function addShadow(label, offset)
    offset = offset or UDim2.new(0, 1, 0, 1)
    local shadow = Instance.new("TextLabel")
    shadow.Name = "Shadow"
    shadow.Size = UDim2.new(1, offset.X.Offset, 1, offset.Y.Offset)
    shadow.Position = UDim2.new(0, offset.X.Offset, 0, offset.Y.Offset)
    shadow.BackgroundTransparency = 1
    shadow.Text = label.Text
    shadow.Font = label.Font
    shadow.TextSize = label.TextSize
    shadow.TextXAlignment = label.TextXAlignment
    shadow.TextYAlignment = label.TextYAlignment
    shadow.TextWrapped = label.TextWrapped
    shadow.TextColor3 = THEME.text_shadow
    shadow.ZIndex = math.max(0, label.ZIndex - 1)
    shadow.Parent = label.Parent
    label:GetPropertyChangedSignal("Text"):Connect(function()
        shadow.Text = label.Text
    end)
    return shadow
end


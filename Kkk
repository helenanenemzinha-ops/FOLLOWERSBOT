local function isInsidePlayer(obj)
    local p = obj.Parent
    while p and p ~= workspace do
        if p:IsA("Backpack") then return true end
        if p:IsA("Model") and p:FindFirstChildOfClass("Humanoid") then return true end
        p = p.Parent
    end
    return false
end

local function findDroppedGun()
    local root = get_root()
    local myPos = root and root.Position or Vector3.zero
    local best, bestD = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Tool") and obj.Name:lower():find("gun") then
            if not isInsidePlayer(obj) then
                local handle = obj:FindFirstChild("Handle")
                if handle then
                    local d = (handle.Position - myPos).Magnitude
                    if d < bestD then best, bestD = obj, d end
                end
            end
        end
    end
    return best
end

local function teleportToGun(gun)
    if not gun or not gun.Parent or Bypass.paused() then return end
    local root = get_root(); if not root then return end
    local handle = gun:FindFirstChild("Handle") or gun:FindFirstChildWhichIsA("BasePart")
    if not handle then return end
    local jitter = Vector3.new(
        (math.random() - 0.5) * 0.3,
        cfg.tp_gun_offset,
        (math.random() - 0.5) * 0.3)
    local dest = handle.Position + jitter
    if cfg.stealth_tp then
        pcall(function() Bypass.stealth_move(root, dest, { step = 15, pace = 0.045 }) end)
    else
        root.CFrame = CFrame.new(dest)
    end
    task.wait(0.05)
    if gun.Parent then
        pcall(function() firetouchinterest(root, handle, 0) end)
        task.wait(0.02)
        pcall(function() firetouchinterest(root, handle, 1) end)
    end
end

task.spawn(function()
    while not Bypass.is_killed() do
        if cfg.tp_gun_auto and not Bypass.paused() then
            local sheriff = GetSheriffPlayer()
            local hasGun = sheriff ~= nil
            if hasGun then sheriffHadGun = true; lastSheriff = sheriff end
            if sheriffHadGun and not hasGun then
                local now = tick()
                if now - tp_gun_last >= cfg.tp_gun_cd and not tp_gun_busy then
                    local gun = findDroppedGun()
                    if gun then
                        tp_gun_busy = true; tp_gun_last = now
                        task.spawn(function()
                            teleportToGun(gun)
                            task.wait(0.4)
                            tp_gun_busy = false
                            sheriffHadGun = false
                        end)
                    end
                end
            end
        end
        task.wait(cfg.tp_gun_watch)
    end
end)

